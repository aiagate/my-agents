#!/usr/bin/env sh
set -eu

subject=$(head -n 1 "$1")

if printf '%s\n' "$subject" | grep -qE '^Merge '; then
    exit 0
fi

if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9-]*\))?: .+'; then
    echo "Error: subject must match Conventional Commits: type(scope)?: summary" >&2
    exit 1
fi

if ! printf '%s\n' "$subject" | LC_ALL=C grep -qE '^[ -~]+$'; then
    echo "Error: subject must be printable ASCII" >&2
    exit 1
fi
