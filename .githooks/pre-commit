#!/usr/bin/env sh
set -eu

if uv run --locked python --version >/dev/null 2>&1; then
    run() { uv run --locked "$@"; }
elif [ -x "$PWD/.venv/bin/ruff" ]; then
    PATH="$PWD/.venv/bin:$PATH"
    export PATH
    run() { "$@"; }
else
    echo "Error: neither uv run --locked nor .venv/bin is usable" >&2
    exit 1
fi

run ruff check .
run ruff format --check .
run ty check
run python -m tools.project_lint
